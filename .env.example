# Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set as Supabase Edge Function secrets (not read by the frontend):
#   supabase secrets set RESEND_API_KEY=... SUPABASE_SERVICE_ROLE_KEY=... ESCALATION_MANAGER_EMAIL=... ESCALATION_HOD_EMAIL=...
RESEND_API_KEY=
RESEND_FROM_EMAIL=MaintOps <notifications@yourdomain.com>
ESCALATION_MANAGER_NAME=
ESCALATION_MANAGER_EMAIL=
ESCALATION_HOD_NAME=
ESCALATION_HOD_EMAIL=
